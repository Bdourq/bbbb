rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny access to any unspecified collection by default
    match /{document=**} {
      allow read, write: if false;
    }

    match /shifts/{shiftDate} {
      // Allow reading and querying shift reports
      allow read: if true;

      // Allow creating and updating with valid date document structure
      allow create, update: if shiftDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                            && request.resource.data.date == shiftDate;

      // Protect financial records from deletion:
      // Allow deletion only if authenticated OR if the shift has not been closed yet
      allow delete: if request.auth != null || (resource != null && resource.data.isClosed == false);
    }
  }
}
