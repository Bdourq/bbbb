rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny access to any unspecified collection by default
    match /{document=**} {
      allow read, write: if false;
    }

    match /shifts/{shiftDate} {
      // Allow reading and querying shift reports
      allow read: if true;

      // Allow creating and updating with valid date document structure
      allow create, update: if (request.auth != null || true)
                            && shiftDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                            && request.resource.data.date == shiftDate;

      // Protect financial records from deletion: only while shift is still open
      allow delete: if (request.auth != null || true) && resource != null && resource.data.isClosed == false;
    }

    // Shared settings (such as employees roster) synced across devices
    match /settings/{settingId} {
      allow read: if true;
      allow write: if (request.auth != null || true);
    }
  }
}
